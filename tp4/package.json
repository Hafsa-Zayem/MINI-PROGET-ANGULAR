{
  "name": "tp4",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "ts-node --project API/tsconfig.json API/index.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
